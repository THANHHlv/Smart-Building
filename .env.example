# =============================================================================
# Smart Building Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_NAME=smart-building-platform
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_building
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Thanh?1015
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# --- Kafka (Phase 4) ---
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Security ---
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Payment Gateway (VNPay) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/return
PAYMENT_GATEWAY_MOCK=true

# --- Billing Engine ---
BILLING_MANAGEMENT_FEE_PER_SQM=7000
BILLING_PARKING_FEE_PER_SLOT=200000
BILLING_WATER_PRICE_PER_M3=12500
BILLING_ENGINE_CRON_HOUR=2
BILLING_ENGINE_CRON_DAY=1
