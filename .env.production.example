# Copy to .env.production on the EC2 host and fill in the missing values.
# This single Docker Hub repository stores backend-<commit> and frontend-<commit> tags.
DOCKERHUB_REPOSITORY=
IMAGE_TAG=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

APP_LOG_LEVEL=INFO
POSTGRES_HOST=database-1.cluster-c3smkq2uaysz.us-east-2.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_AUTH_MODE=iam
POSTGRES_SSL_ROOT_CERT=certs/AmazonRootCA1.pem
AWS_REGION=us-east-2
REDIS_PORT=6379
SECRET_KEY=
CORS_ORIGINS=[]
# Set a real HTTPS return URL before enabling live VNPay payments.
VNPAY_RETURN_URL=
KAFKA_MOCK_FALLBACK=true
